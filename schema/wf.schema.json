{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/aw/schema/wf.schema.json",
  "title": "Compiled Workflow (WF)",
  "type": "object",
  "required": ["version", "name", "goal", "steps"],
  "properties": {
    "version": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "kind": {"enum": ["agent", "tool", "command", "condition", "artifact"]},
          "prompt": {"type": "string"},
          "tool": {"type": "string"},
          "command": {"type": "string"},
          "condition": {"type": "string"},
          "artifact": {"type": "string"},
          "needs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
