{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/aw/schema/aw.schema.json",
  "title": "Agent Workflow (AW)",
  "type": "object",
  "required": ["version", "name", "goal", "success"],
  "properties": {
    "version": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "context": {"type": "string"},
    "prompt": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "success": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "examples": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
